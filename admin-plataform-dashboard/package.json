    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.10.0",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
