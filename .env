# ── AWS ───────────────────────────────────────────────
AWS_REGION=us-east-1
# Local-only least-privilege profile; production must use an IAM role/OIDC and omit this line.
AWS_PROFILE=ai-gateway-auth-service
# Credenciales: usar el credential chain de AWS SDK (env vars, ~/.aws/credentials, IAM role)
# Si necesitas endpoint override (localstack/testing):
# AWS_ENDPOINT_URL=http://127.0.0.1:4566
STS_SESSION_DURATION_SECONDS=3600
STS_REFRESH_BUFFER_SECONDS=120
STATIC_KEYS_CACHE_TTL_SECONDS=900

# ── Security ──────────────────────────────────────────
# Pepper para HMAC de API keys (256+ bits de entropía, generado una vez y nunca rotado sin re-hashear)
# API_KEY_PEPPER is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# Secreto para firmar JWT de sesión (mínimo 256 bits)
# JWT_SIGNING_SECRET is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# Secreto para firmar JWT de servicio-a-servicio
# SERVICE_JWT_SECRET is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# RESEND_API_KEY is managed by AWS Secrets Manager: ai-gateway/dev/runtime
RESEND_FROM_EMAIL=no-reply@jnmtortas.com

# ── Payment providers ─────────────────────────────────
PAYPAL_BASE_URL=https://api-m.paypal.com
# PAYPAL_CLIENT_ID is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# PAYPAL_CLIENT_SECRET is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# PAYPAL_WEBHOOK_ID is managed by AWS Secrets Manager: ai-gateway/dev/runtime

# ── Observability ─────────────────────────────────────
# OTEL_ENABLED is managed by AWS SSM: /ai-gateway/dev/common/OTEL_ENABLED
# OTEL_EXPORTER_OTLP_ENDPOINT is managed by AWS SSM: /ai-gateway/dev/common/OTEL_EXPORTER_OTLP_ENDPOINT
# OTEL_SERVICE_NAME is managed by AWS SSM: /ai-gateway/dev/common/OTEL_SERVICE_NAME

# ── TLS / mTLS entre microservicios ────────────────────
SECRETS_PROVIDER=aws
CONFIG_RELOAD_ENABLED=true # AWS SSM: /ai-gateway/dev/common/CONFIG_RELOAD_ENABLED
CONFIG_RELOAD_INTERVAL_SECONDS=30 # AWS SSM: /ai-gateway/dev/common/CONFIG_RELOAD_INTERVAL_SECONDS
CONFIG_RELOAD_MAX_STALE_SECONDS=300 # AWS SSM: /ai-gateway/dev/common/CONFIG_RELOAD_MAX_STALE_SECONDS
AWS_ENVIRONMENT=dev
AWS_PARAMETER_PREFIX=/ai-gateway/dev
AWS_SECRETS_PREFIX=ai-gateway/dev
AWS_RUNTIME_SECRET_ID=ai-gateway/dev/runtime
AWS_TLS_SECRET_NAMESPACE=ai-gateway/dev/tls
# TLS_MODE is managed by AWS SSM: /ai-gateway/dev/common/TLS_MODE
TLS_CERT_PROVIDER=aws
TLS_CERT_NAMESPACE=ai-gateway/dev/tls
# TLS_CERT_REFRESH_SECONDS is managed by AWS SSM: /ai-gateway/dev/common/TLS_CERT_REFRESH_SECONDS
# TLS_MIN_VALIDITY_SECONDS is managed by AWS SSM: /ai-gateway/dev/common/TLS_MIN_VALIDITY_SECONDS
# TLS_DNS_SUFFIX is managed by AWS SSM: /ai-gateway/dev/common/TLS_DNS_SUFFIX
# TLS_IP_SANS is managed by AWS SSM: /ai-gateway/dev/common/TLS_IP_SANS

