# ── Postgres ──────────────────────────────────────────
# POSTGRES_PASSWORD is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
LOCAL_DATABASES_ENABLED=true
POSTGRES_USER=ai_gateway
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASES=gateway_db,router_db,credentials_db,auth_db,keys_db,catalog_db,subscription_db,payments_db,billing_db,usage_db,invoicing_db,customer_bff_db
PGADMIN_DEFAULT_EMAIL=admin@nexusgateway.com
# PGADMIN_DEFAULT_PASSWORD is managed by AWS Secrets Manager: ai-gateway/dev/runtime

# ── Una base public por microservicio, en el mismo PostgreSQL ──────────
# USAGE_SERVICE_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# API_SERVICE_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# AUTH_SERVICE_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# CREDENTIAL_MANAGER_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# INVOICE_SERVICE_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# KEY_SERVICES_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# PAYMENT_SERVICES_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# SUBSCRIPTION_SERVICE_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# BILLING_SERVICE_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# API_GATEWAY_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# MODEL_ROUTER_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# CUSTOMER_BFF_DATABASE_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# DATABASE_MAX_CONNECTIONS is managed by AWS SSM: /ai-gateway/dev/common/DATABASE_MAX_CONNECTIONS
# DATABASE_ACQUIRE_TIMEOUT_MS is managed by AWS SSM: /ai-gateway/dev/common/DATABASE_ACQUIRE_TIMEOUT_MS
# DATABASE_IDLE_TIMEOUT_MS is managed by AWS SSM: /ai-gateway/dev/common/DATABASE_IDLE_TIMEOUT_MS

# ── Redis ─────────────────────────────────────────────
# REDIS_PASSWORD is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# REDIS_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# REDIS_POOL_SIZE is managed by AWS SSM: /ai-gateway/dev/common/REDIS_POOL_SIZE
# REDIS_TIMEOUT_MS is managed by AWS SSM: /ai-gateway/dev/common/REDIS_TIMEOUT_MS

# ── NATS ──────────────────────────────────────────────
NATS_USERNAME=nats_admin
# NATS_PASSWORD is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# NATS_URL is managed by AWS Secrets Manager: ai-gateway/dev/runtime

# ── Vector database / Qdrant ──────────────────────────
# Usado cuando se habilite almacenamiento/búsqueda vectorial; el gateway de embeddings
# actualmente proxya embeddings y no persiste vectores.
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY is managed by AWS Secrets Manager: ai-gateway/dev/runtime
QDRANT_EMBEDDING_COLLECTION=nexus_embeddings_v2

# ── Ingestión y embeddings ───────────────────────────
# El endpoint es configuración operativa; la clave es gestionada por AWS Secrets Manager.
EMBEDDING_API_URL=https://openrouter.ai/api
# EMBEDDING_API_KEY is managed by AWS Secrets Manager: ai-gateway/dev/runtime
# EMBEDDING_MODEL is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_MODEL
# EMBEDDING_VERSION is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_VERSION
# EMBEDDING_COST_MICROS_PER_1K is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_COST_MICROS_PER_1K
INGESTION_STRATEGY_VERSION=v2-qwen-token-800-overlap-120
# EMBEDDING_MAX_INPUT_TOKENS is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_MAX_INPUT_TOKENS
# EMBEDDING_DIMENSIONS is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_DIMENSIONS
# EMBEDDING_MAX_BATCH_INPUTS is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_MAX_BATCH_INPUTS
# EMBEDDING_MAX_BATCH_TOKENS is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_MAX_BATCH_TOKENS
# EMBEDDING_MAX_CONCURRENT_REQUESTS is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_MAX_CONCURRENT_REQUESTS
# EMBEDDING_MAX_RETRIES is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_MAX_RETRIES
# EMBEDDING_RETRY_BASE_MS is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_RETRY_BASE_MS
# EMBEDDING_RETRY_MAX_MS is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_RETRY_MAX_MS
# EMBEDDING_REQUEST_TIMEOUT_SECONDS is managed by AWS SSM: /ai-gateway/dev/common/EMBEDDING_REQUEST_TIMEOUT_SECONDS
EMBEDDING_QUERY_INSTRUCTION="Given a user query, retrieve relevant passages that answer the query"
EMBEDDING_TOKENIZER_PATH=.runtime/tokenizers/qwen3-embedding-8b-tokenizer.json
EMBEDDING_TOKENIZER_URL=https://huggingface.co/Qwen/Qwen3-Embedding-8B/resolve/4e423935c619ae4df87b646a3ce949610c66241c/tokenizer.json
EMBEDDING_TOKENIZER_SHA256=83cdf8c3a34f68862319cb1810ee7b1e2c0a44e0864ae930194ddb76bb7feb8d
EMBEDDING_HTTP_REFERER=https://jnmtortas.com
EMBEDDING_OPENROUTER_TITLE="Nexus Gateway"
EMBEDDING_DEDUP_LEASE_SECONDS=180
EMBEDDING_MAX_FILE_FILTER_IDS=20000

