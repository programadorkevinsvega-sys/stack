# ── Fase 9: producción y recuperación ─────────────────
# Las credenciales de PostgreSQL/R2/Qdrant se administran desde AWS Secrets Manager. Estas
# variables solo controlan límites operativos y se usan por los scripts de
# backup/restore/load cuando se ejecutan explícitamente.
R2_BACKUP_TRANSFERS=8
R2_BACKUP_CHECKERS=16
PAYMENT_SERVICES_GRPC_ENDPOINT=http://127.0.0.1:50066
USAGE_SERVICE_GRPC_ENDPOINT=http://127.0.0.1:50068
GRPC_TIMEOUT_SECS=5
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3002,http://localhost:3002
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_IP_REQUESTS_PER_MINUTE=120
RATE_LIMIT_USER_REQUESTS_PER_MINUTE=300

# ── Auth / email ─────────────────────────────────────
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=30
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_APP_BASE_URL=http://localhost:3001
AUTH_MFA_ISSUER=ai-gateway
AUTH_MFA_KMS_KEY_ID=alias/ai-gateway-auth-mfa

# ── AWS ───────────────────────────────────────────────
AWS_REGION=us-east-1
# Local-only profile; production should use an IAM role/OIDC instead.
# AWS_PROFILE=ai-gateway-auth-service
AWS_ENVIRONMENT=dev
AWS_PARAMETER_PREFIX=/ai-gateway/dev
AWS_SECRETS_PREFIX=ai-gateway/dev
AWS_RUNTIME_SECRET_ID=ai-gateway/dev/runtime
AWS_TLS_SECRET_NAMESPACE=ai-gateway/dev/tls
# Credenciales: usar el credential chain de AWS SDK (env vars, ~/.aws/credentials, IAM role)
# Si necesitas endpoint override (localstack/testing):
# AWS_ENDPOINT_URL=http://localhost:4566
STS_SESSION_DURATION_SECONDS=3600
STS_REFRESH_BUFFER_SECONDS=120
STATIC_KEYS_CACHE_TTL_SECONDS=900
# STS role chaining: si se configura, credential-manager hará una segunda llamada AssumeRole
# contra este ARN usando las credenciales base de la cuenta destino.
# Esto produce credenciales scoped a los permisos del rol Mantle en vez de reenviar
# las credenciales completas al proxy Bedrock Mantle.
# Requiere que el rol destino tenga trust policy permitiendo al rol base (de la cuenta AWS) asumirlo.
# MANTLE_ROLE_ARN=arn:aws:iam::123456789012:role/mantle-bedrock-proxy

# ── Security ──────────────────────────────────────────
# Pepper para HMAC de API keys (256+ bits de entropía, generado una vez y nunca rotado sin re-hashear)
API_KEY_PEPPER=change-me-to-a-random-64-char-hex-string # AWS Secrets Manager in production
# Secreto para firmar JWT de sesión (mínimo 256 bits)
JWT_SIGNING_SECRET=change-me-to-a-random-64-char-hex-string # AWS Secrets Manager in production
# Secreto para firmar JWT de servicio-a-servicio
SERVICE_JWT_SECRET=change-me-to-another-random-64-char-hex-string # AWS Secrets Manager in production
# KID opcional para la clave de firma (auto-generado del hash del secreto si no se define)
# SERVICE_JWT_KID=k1
# Secretos anteriores para verificación durante rotación de claves JWT (separados por coma)
# SERVICE_JWT_PREVIOUS_SECRETS=old-secret-1,older-secret-2
RESEND_API_KEY=re_xxx # AWS Secrets Manager in production
RESEND_FROM_EMAIL=no-reply@jnmtortas.com

# ── Payment providers ─────────────────────────────────
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=paypal-client-id # AWS Secrets Manager in production
PAYPAL_CLIENT_SECRET=paypal-client-secret # AWS Secrets Manager in production
PAYPAL_WEBHOOK_ID=paypal-webhook-id # AWS Secrets Manager in production

# ── Observability ─────────────────────────────────────
OTEL_ENABLED=false # AWS SSM in production: /ai-gateway/dev/common/OTEL_ENABLED
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 # AWS SSM in production
OTEL_SERVICE_NAME=ai-gateway # AWS SSM in production
# OBSERVABILITY_USER_HASH_SALT is managed by AWS Secrets Manager: ai-gateway/dev/runtime.

# ── TLS / mTLS multicloud ───────────────────────────────
# Critical values are loaded strictly from AWS; there is no Vault fallback.
SECRETS_PROVIDER=aws              # env | aws (vault is legacy-only and explicit)
CONFIG_RELOAD_ENABLED=true       # AWS SSM/Secrets Manager polling
CONFIG_RELOAD_INTERVAL_SECONDS=30 # Minimum polling interval; AWS SSM in production
CONFIG_RELOAD_MAX_STALE_SECONDS=300 # Maximum age of last known-good snapshot
# AWS_RUNTIME_SECRET_ID above identifies the JSON secret loaded by every service.
# TLS_MODE controls transport policy; it does not select the secret backend.
TLS_MODE=disabled # AWS SSM in production: /ai-gateway/dev/common/TLS_MODE
TLS_CERT_PROVIDER=aws           # aws only for production mTLS
TLS_CERT_NAMESPACE=ai-gateway/dev/tls
TLS_CERT_REFRESH_SECONDS=300 # AWS SSM in production
TLS_MIN_VALIDITY_SECONDS=3600 # AWS SSM in production
TLS_DNS_SUFFIX=svc.internal # AWS SSM in production
TLS_IP_SANS=127.0.0.1 # AWS SSM in production
# TLS_ALT_NAMES=localhost        # optional extra SANs appended to every Vault-issued certificate
# TLS_IP_SANS=127.0.0.1          # optional IP SANs for local gRPC endpoints

# AWS Secrets Manager. Use the default AWS role/credential chain.
# AWS_TLS_SECRET_ID=ai-gateway/dev/tls/shared     # optional global override
# BILLING_SERVICE_TLS_SECRET_ID=prod/nexus/tls/billing-service

# Azure Key Vault. Prefer managed_identity or workload_identity in production.
# AZURE_KEY_VAULT_URL=https://nexus-prod.vault.azure.net
# AZURE_AUTH_MODE=managed_identity                 # managed_identity | workload_identity | developer_tools
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_TLS_SECRET_NAME=prod-nexus-tls-shared      # optional global override
# BILLING_SERVICE_TLS_SECRET_NAME=prod-nexus-tls-billing-service

# HashiCorp Vault variables are intentionally commented after AWS migration.
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_NAMESPACE=
# VAULT_AUTH_METHOD=approle
# VAULT_AUTH_MOUNT=approle
# VAULT_APPROLE_ROLE_ID_FILE=.runtime/vault/role-id
# VAULT_APPROLE_SECRET_ID_FILE=.runtime/vault/secret-id

# Stored AWS/Azure/Vault-KV secret format:
# {
#   "certificate_chain_pem": "-----BEGIN CERTIFICATE-----...",
#   "private_key_pem": "-----BEGIN PRIVATE KEY-----...",
#   "ca_bundle_pem": "-----BEGIN CERTIFICATE-----..."
# }
#
# TLS_MODE only applies to communication between microservices over gRPC.
# PostgreSQL, Redis, NATS/JetStream and Vault keep the scheme configured in their own URLs.
# When TLS_MODE=tls|mtls, all *_GRPC_ENDPOINT values must use https:// and their
# hosts must match a certificate SAN.
