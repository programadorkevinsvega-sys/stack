# Backend-for-Frontend URL. Required — the dashboard will not start without it.
# Examples:
#   http://localhost:4000   (local BFF dev server)
#   https://bff.nexus.ai    (production)
NEXT_PUBLIC_BFF_URL=https://api.jnmtortas.com
