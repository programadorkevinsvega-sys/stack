# =============================================================================
# Admin BFF — Backend For Frontend (Admin Dashboard)
# =============================================================================
# Copy this file to .env and fill in your values.

# === Service-to-Service JWT ===
SERVICE_JWT_SECRET=
ADMIN_BFF_SERVICE_JWT_ISSUER=admin-bff
ADMIN_BFF_SERVICE_JWT_SUBJECT=admin-bff

# === gRPC Endpoints (internal service mesh) ===
AUTH_SERVICE_GRPC_ENDPOINT=http://auth-service:50051
CATALOG_GRPC_ENDPOINT=http://catalog:50054
SUBSCRIPTION_SERVICE_GRPC_ENDPOINT=http://subscription-service:50053
BILLING_SERVICE_GRPC_ENDPOINT=http://billing-service:50055
INVOICE_SERVICE_GRPC_ENDPOINT=http://invoice-service:50056
FILE_SERVICE_GRPC_ENDPOINT=http://file-service:50071
USAGE_SERVICE_GRPC_ENDPOINT=http://usage-service:50058
ROUTER_SERVICE_GRPC_ENDPOINT=http://model-router:50059

# === HTTP Server ===
ADMIN_BFF_BIND_ADDR=0.0.0.0
HTTP_PORT=8081

# === CORS (frontend origins) ===
# Comma-separated list of allowed origins. Use "*" only for development.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# === Cookies ===
# Set to false for local development without HTTPS.
COOKIE_SECURE=true

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# === NATS JetStream (DLQ depth for storage operations) ===
NATS_URL=nats://localhost:4222
NATS_USERNAME=
NATS_PASSWORD=

# === gRPC Timeouts ===
# Maximum time (seconds) for a single gRPC call to complete.
GRPC_TIMEOUT_SECS=5

# === Rate Limiting ===
RATE_LIMIT_IP_REQUESTS_PER_MINUTE=60
RATE_LIMIT_USER_REQUESTS_PER_MINUTE=120
