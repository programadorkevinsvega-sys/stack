# =============================================================================
# Customer BFF — Backend For Frontend
# =============================================================================
# Copy this file to .env and fill in your values.

# === Service-to-Service JWT ===
SERVICE_JWT_SECRET=
CUSTOMER_BFF_SERVICE_JWT_ISSUER=customer-bff
CUSTOMER_BFF_SERVICE_JWT_SUBJECT=customer-bff

# === gRPC Endpoints (internal service mesh) ===
AUTH_SERVICE_GRPC_ENDPOINT=http://auth-service:50051
KEY_SERVICES_GRPC_ENDPOINT=http://key-services:50052
SUBSCRIPTION_SERVICE_GRPC_ENDPOINT=http://subscription-service:50053
CATALOG_GRPC_ENDPOINT=http://catalog:50054
BILLING_SERVICE_GRPC_ENDPOINT=http://billing-service:50055
INVOICE_SERVICE_GRPC_ENDPOINT=http://invoice-service:50056
PAYMENT_SERVICES_GRPC_ENDPOINT=http://payment-services:50057
USAGE_SERVICE_GRPC_ENDPOINT=http://usage-service:50058

# === HTTP Server ===
CUSTOMER_BFF_BIND_ADDR=0.0.0.0
HTTP_PORT=8080

# === CORS (frontend origins) ===
# Comma-separated list of allowed origins. Use "*" only for development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === Cookies ===
# Set to false for local development without HTTPS.
COOKIE_SECURE=true

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# === gRPC Timeouts ===
# Maximum time (seconds) for a single gRPC call to complete.
GRPC_TIMEOUT_SECS=5

# === Rate Limiting ===
RATE_LIMIT_IP_REQUESTS_PER_MINUTE=60
RATE_LIMIT_USER_REQUESTS_PER_MINUTE=300
