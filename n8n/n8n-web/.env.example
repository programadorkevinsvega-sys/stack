# ========================================
# 🔧 CONFIGURACIÓN n8n EN MODO QUEUE
# ========================================
# COPIA ESTE ARCHIVO A .env Y ACTUALIZA LOS VALORES
# cp .env.example .env
#
# ⚠️ IMPORTANTE: Redis, PostgreSQL y Vault DEBEN estar
# corriendo en ../database/docker-compose.*.yml
# Este archivo define CONEXIONES a esos servicios externos.

# ========================================
# 🔐 ENCRIPTACIÓN Y ALMACENAMIENTO
# ========================================
# Clave de encriptación única para n8n (generar una nueva para producción)
# Usarla para encriptar credenciales y datos sensibles
# Generar con: openssl rand -base64 32
N8N_ENCRYPTION_KEY=Kevins1612522026SecretKeyForN8nEncryptionChangeInProduction123!

# Carpeta donde n8n almacena datos locales (credenciales, workflows)
DATA_FOLDER=/home/node/.n8n

# ========================================
# 📡 REDIS (Cola de Trabajos - EXTERNO)
# ========================================
# IP/Host donde está Redis corriendo (desde ../database/docker-compose.redis.yml)
# Opciones:
#   - "redis" si n8n está en la MISMA red Docker (stack-network)
#   - "127.0.0.1" si n8n corre en el host local
#   - "100.121.34.76" si accedes desde Tailscale/VPN
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
# Redis requiere contraseña (configurada en docker-compose.redis.yml)
QUEUE_BULL_REDIS_PASSWORD=Kevins1612522026

# ========================================
# 🗄️ PostgreSQL (Base de Datos - EXTERNO)
# ========================================
# IP/Host donde está PostgreSQL corriendo (desde ../database/docker-compose.postgres.yml)
# Opciones:
#   - "postgres" si n8n está en la MISMA red Docker (stack-network)
#   - "127.0.0.1" si n8n corre en el host local
#   - "100.121.34.76" si accedes desde Tailscale/VPN
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=Kevins1612522026

# Tipo de base de datos (obligatorio para modo queue)
DB_TYPE=postgresdb

# ========================================
# ⚙️ MODO DE EJECUCIÓN (Queue Mode)
# ========================================
# Modo de ejecución distribuido (queue = con workers)
EXECUTIONS_MODE=queue

# Redis database para cola de trabajos (0-15)
QUEUE_BULL_REDIS_DB=0

# Número de workers concurrentes
WORKER_REPLICAS=2

# ========================================
# 🌐 n8n WEB (MAIN - Tu PC/Host Local)
# ========================================
# La IP o dominio accesible desde navegadores y webhooks desde internet
# Opciones:
#   - "localhost" para desarrollo local SOLO
#   - "100.121.34.76" para acceso remoto via Tailscale
#   - Tu IP local (ej: 192.168.1.50) si n8n es accesible en la LAN
#   - Tu dominio (ej: n8n.tudominio.com) si tienes DNS configurado
N8N_HOST=100.121.34.76
N8N_PORT=5678

# Protocolo (http o https)
# https requiere certificado SSL/TLS (recomendado para producción)
N8N_PROTOCOL=http

# ========================================
# 🕐 CONFIGURACIÓN GENERAL n8n
# ========================================
# Zona horaria para los logs y timestamps de n8n
TZ=America/Bogota
GENERIC_TIMEZONE=America/Bogota

# Entorno (development o production)
NODE_ENV=production

# ========================================
# 🔧 WEBHOOKS Y CREDENCIALES
# ========================================
# URL base para webhooks (debe ser accesible desde internet)
WEBHOOK_URL=http://100.121.34.76:5678/webhook

# Permitir credenciales sin encripción (¡NUNCA en producción!)
CREDENTIALS_OVERWRITE_FRONTEND=true

# ========================================
# 🔐 VAULT (EXTERNO - Almacén de Secretos)
# ========================================
# Dirección donde está Vault (levantado en ../database/)
# Opciones:
#   - "http://vault:8500" si n8n está en stack-network
#   - "http://127.0.0.1:8500" si n8n está en el host local
#   - "http://100.121.34.76:8500" si accedes desde Tailscale/VPN
VAULT_ADDR=http://100.121.34.76:8500
VAULT_API_ADDR=http://0.0.0.0:8500
VAULT_UI=true

# AppRole de n8n para autenticar con Vault
VAULT_AUTH_PATH=auth/approle
VAULT_ROLE_ID=46f0c78c-255f-52dd-4910-538bdd74672e
VAULT_APPROLE_SECRET_ID=3f1bc789-63d0-f469-b7be-7c1de57e8168

# ========================================
# 🔧 WORKERS (Configuración Local)
# ========================================
# Número de trabajos concurrentes por worker
WORKER_CONCURRENCY=2

# Modo de ejecución (queue = distribuido con workers)
EXECUTIONS_MODE=queue

# ========================================
# 🐰 RabbitMQ (Message Broker - OPCIONAL)
# ========================================
# Si usas RabbitMQ para colas (desde ../database/docker-compose.rabbitmq.yml)
# Formato: amqp://usuario:password@host:puerto/vhost
RABBITMQ_AMQP_URL=amqp://KevinsAdmin:Kevins1612522026@rabbitmq:5672
# O configuración individual:
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# RABBITMQ_USER=KevinsAdmin
# RABBITMQ_PASSWORD=Kevins1612522026

# ========================================
# ☕ Kafka (Event Streaming - OPCIONAL)
# ========================================
# Si usas Kafka para eventos (desde ../database/docker-compose.kafka.yml)
KAFKA_BROKERS=kafka:9092
# Para múltiples brokers: KAFKA_BROKERS=kafka1:9092,kafka2:9092,kafka3:9092
KAFKA_GROUP_ID=n8n-workers

# ========================================
# 🍃 MongoDB (Base de Datos NoSQL - OPCIONAL)
# ========================================
# Si usas MongoDB como base de datos alternativa (desde ../database/docker-compose.mongodb.yml)
# Formato: mongodb://usuario:password@host:puerto/database
MONGODB_URI=mongodb://KevinsAdmin:Kevins1612522026@mongodb:27017/n8n

# ========================================
# 🐬 MySQL (Base de Datos - OPCIONAL)
# ========================================
# Si usas MySQL en lugar de PostgreSQL (desde ../database/docker-compose.mysql.yml)
# DB_TYPE=mysql
# DB_MYSQL_HOST=mysql
# DB_MYSQL_PORT=3306
# DB_MYSQL_DATABASE=n8n
# DB_MYSQL_USER=KevinsAdmin
# DB_MYSQL_PASSWORD=Kevins1612522026

# ========================================
# 📦 MinIO (S3 Storage - OPCIONAL)
# ========================================
# Si usas MinIO para almacenamiento S3 (desde ../database/docker-compose.minio.yml)
# Endpoint de MinIO (API S3)
MINIO_ENDPOINT=http://minio:9000
# Credenciales
MINIO_ACCESS_KEY_ID=KevinsAdmin
MINIO_SECRET_ACCESS_KEY=Kevins1612522026
# Bucket por defecto
MINIO_BUCKET_NAME=n8n

# ========================================
# 📝 NOTAS IMPORTANTES
# ========================================
# 1. REDIS DEBE estar corriendo (desde ../database/)
#    Verificar conexión: redis-cli -h redis ping
#
# 2. PostgreSQL DEBE estar corriendo (desde ../database/)
#    Verificar conexión:
#    psql -h postgres -U n8n_user -d n8n -c "SELECT 1"
#
# 3. LA RED DOCKER:
#    Los hosts (redis, postgres, etc.) se resuelven automáticamente 
#    SI n8n corre en la MISMA red Docker (stack-network)
#
# 4. ACCESO DESDE EL HOST LOCAL:
#    Si n8n corre FUERA de Docker, usa IPs concretas:
#    - QUEUE_BULL_REDIS_HOST=127.0.0.1
#    - DB_POSTGRESDB_HOST=127.0.0.1
#    - VAULT_ADDR=http://127.0.0.1:8200
#    - KAFKA_BROKERS=127.0.0.1:9092
#    - etc.
#
# 5. ACCESO DESDE TAILSCALE/REMOTO:
#    Si accedes desde otra máquina via Tailscale, usa:
#    - QUEUE_BULL_REDIS_HOST=100.121.34.76
#    - DB_POSTGRESDB_HOST=100.121.34.76
#    - VAULT_ADDR=http://100.121.34.76:8200
#    - etc.
#    (Los servicios en ../database están expuestos a Tailscale)
#
# 6. PUERTOS:
#    - n8n Web: 5678
#    - PostgreSQL: 5432
#    - Redis: 6379
#    - Vault: 8200
#    - RabbitMQ: 5672 (AMQP), 15672 (Management)
#    - Kafka: 9092
#    - MongoDB: 27017
#    - MySQL: 3306
#    - MinIO: 9000 (API), 9001 (Console)
#
# 7. CREDENCIALES ESTÁNDAR (excepto PostgreSQL):
#    Usuario: KevinsAdmin
#    Password: Kevins1612522026
#
# 8. UIs ADMINISTRATIVAS (desde ../database/):
#    - pgAdmin: http://100.121.34.76:5050
#    - Adminer: http://100.121.34.76:8080
#    - RabbitMQ: http://100.121.34.76:15672
#    - Mongo Express: http://100.121.34.76:8083
#    - PhpMyAdmin: http://100.121.34.76:8084
#    - MinIO Console: http://100.121.34.76:9001
#    - Redis Commander: http://100.121.34.76:8081
#    - RedisInsight: http://100.121.34.76:5540
#    - Vault UI: http://100.121.34.76:8200/ui/