# ============================================================
# 🔧 n8n CONFIGURACIÓN MODO QUEUE (PRODUCCIÓN)
# ============================================================
# Identificador del Túnel: bravexcolombia.com
# Infraestructura: Docker (stack-network + proxy-network)

# ========================================
# 🔐 ENCRIPTACIÓN Y ALMACENAMIENTO
# ========================================
# Clave para encriptar credenciales en la base de datos.
N8N_ENCRYPTION_KEY=Kevins1612522026

# Ruta interna del contenedor (No cambiar si usas Docker)
DATA_FOLDER=/home/node/.n8n

# Timeout para tareas en los workers (en ms). Ajusta según tus necesidades, pero ten cuidado con valores muy bajos que puedan causar fallos en tareas largas.
N8N_RUNNERS_TASK_TIMEOUT=2000
# ========================================
# 📡 REDIS (Cola de Trabajos - stack-network)
# ========================================
# n8n-web y n8n-worker buscan al contenedor llamado "redis"
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=Kevins1612522026
QUEUE_BULL_REDIS_DB=5
# ========================================
# 🗄️ PostgreSQL (Base de Datos - stack-network)
# ========================================
# Conexión interna entre contenedores
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n-kevins
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=Kevins1612522026
# ========================================
# ⚙️ MODO DE EJECUCIÓN (Scaling)
# ========================================
# Define que n8n use Workers para las tareas
EXECUTIONS_MODE=queue
# true para que las ejecuciones manuales también se vayan a los workers, si no, se quedarán en el web y no escalarán, pero lo dejamos configurable por si alguien quiere el comportamiento antiguo
# false para que las ejecuciones manuales se queden en el web, lo que puede ser útil para debugging o si no quieres que escalen, pero lo dejamos configurable por si alguien quiere el comportamiento antiguo
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
# true para que las ejecuciones manuales también se vayan a los workers, si no, se quedarán en el web y no escalarán, pero lo dejamos configurable por si alguien quiere el comportamiento antiguo
# false para que las ejecuciones manuales se queden en el web, lo que puede ser útil para debugging o si no quieres que escalen, pero lo dejamos configurable por si alguien quiere el comportamiento antiguo
N8N_DISABLE_MANUAL_EXECUTIONS_TO_WORKERS=false
# Número de workers a levantar (definido también en deploy del yml)
WORKER_REPLICAS=2
WORKER_CONCURRENCY=2

# ========================================
# 🌐 n8n WEB (Identidad vía Cloudflare)
# ========================================
# El dominio que el usuario escribe en el navegador
N8N_HOST=n8n.bravexcolombia.com

# Puerto INTERNO donde n8n escucha dentro de su contenedor. 
# Importante: Nginx lo busca aquí (5678), NO en el 443.
N8N_PORT=5678

# Protocolo final que ve el usuario. Obligatorio https para Cloudflare.
N8N_PROTOCOL=https

# Entorno de ejecución
NODE_ENV=production

# ========================================
# 🔧 WEBHOOKS (Crucial para integraciones)
# ========================================
# Esta URL debe ser la pública. SIN PUERTO, ya que Cloudflare
# gestiona el tráfico por el puerto estándar 443.
WEBHOOK_URL=https://n8n.bravexcolombia.com/

# ========================================
# 🔐 VAULT (Gestión de Secretos)
# ========================================
# Dirección interna para que n8n-web hable con Vault en stack-network

# Configuración de Vault para n8n
N8N_EXTERNAL_SECRETS_DEFAULT_PROVIDER=vault
N8N_VAULT_AUTH_TYPE=approle
N8N_VAULT_SERVER_URL=http://vault:8500
N8N_VAULT_AUTH_ROLE_ID=8e698402-7fc5-f291-f9b2-dbed05cb2a00
N8N_VAULT_AUTH_SECRET_ID=0cff1ab7-8eda-6e65-0145-cd2e7d073527
N8N_VAULT_AUTH_PATH=auth/approle

# Conexión n8n -> MinIO
N8N_S3_ADDRESS=minio
N8N_S3_PORT=9000
N8N_S3_BUCKET_NAME=n8n-files
N8N_S3_ACCESS_KEY=KevinsAdmin
N8N_S3_SECRET_KEY=Kevins1612522026
N8N_S3_REGION=us-east-1

# ====== CONFIGURACIÓN PARA EL PROXY DE NGINX ======

# Intento de modo automático (Solo si tienes licencia, si no, n8n lo ignora)
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# IMPORTANTE para Cloudflare, confía en los headers de proxy para IP real y protocolo
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota
N8N_TRUST_PROXY=true
N8N_TRUST_PROXY_HOPS=2
# ========================================
# 📝 NOTAS DE SEGURIDAD
# ========================================
# 1. Este archivo contiene secretos. Asegura permisos: chmod 600 .env
# 2. Las URLs de Vault y DB usan nombres de servicio (DNS de Docker).
# 3. El puerto 5678 es interno; el túnel lo expone como https (443).