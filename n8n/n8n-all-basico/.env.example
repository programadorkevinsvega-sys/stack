# Configuración general
DATA_FOLDER=/opt/n8n-cluster/n8n-data
N8N_ENCRYPTION_KEY=GeneraUnaClaveSecretaLargaYAleatoriaAqui123!
TZ=America/Bogota
GENERIC_TIMEZONE=America/Bogota

# Configuración de Base de Datos para n8n apuntando a tu Postgres externo
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=n8n_database
DB_POSTGRESDB_HOST=PON_AQUI_LA_IP_DE_TU_POSTGRES
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=tu_usuario_de_postgres
DB_POSTGRESDB_PASSWORD=tu_password_de_postgres

# Configuración del Modo Cola apuntando a tu Redis externo
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=PON_AQUI_LA_IP_DE_TU_REDIS
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=tu_password_de_redis
QUEUE_BULL_REDIS_DATABASE=0

# Zona horaria
GENERIC_TIMEZONE=America/Bogota