# ========================================
# 🔧 VARIABLES DE ENTORNO PARA WORKERS EN VPS
# ========================================
# Este archivo es para workers en el VPS que se CONECTAN
# a servicios EXTERNOS (Redis, PostgreSQL, Vault)
# que ya están corriendo en otro Docker
# 
# COPIA ESTE ARCHIVO A .env EN EL VPS
# cp .env.example.vps .env

# ========================================
# � ENCRIPTACIÓN Y ALMACENAMIENTO
# ========================================
# Clave de encriptación única para n8n
# ⚠️ DEBE SER IGUAL a la que uses en PC LOCAL
# (para poder desencriptar credenciales)
N8N_ENCRYPTION_KEY=Kla misma del local

# Carpeta de almacenamiento
DATA_FOLDER=/home/node/.n8n

# ========================================
# 📡 REDIS (Cola - EXTERNO)
# ========================================
# IP/Host del Docker donde corre Redis
QUEUE_BULL_REDIS_HOST=192.168.1.100
QUEUE_BULL_REDIS_PORT=6379

# ========================================
# 🗄️ PostgreSQL (Base de Datos - EXTERNO)
# ========================================
# IP/Host del Docker donde corre PostgreSQL
DB_POSTGRESDB_HOST=192.168.1.100
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=tu_password_muy_seguro_aqui

DB_TYPE=postgresdb

# ========================================
# ⚙️ MODO DE EJECUCIÓN (Queue Mode)
# ========================================
# Modo de ejecución distribuido (queue = con workers)
EXECUTIONS_MODE=queue

# Redis database para cola de trabajos (0-15)
QUEUE_BULL_REDIS_DB=0

# ========================================
# 🕐 CONFIGURACIÓN GENERAL
# ========================================
# Zona horaria
TZ=America/Bogota
GENERIC_TIMEZONE=America/Bogota

NODE_ENV=production

# ========================================
# 🔐 VAULT (EXTERNO - Opcional)
# ========================================
# Si usas Vault para almacenar secretos
VAULT_ADDR=http://192.168.1.100:8500
VAULT_AUTH_PATH=auth/approle
VAULT_ROLE_ID=tu_role_id
VAULT_SECRET_ID=tu_secret_id

# ========================================
# 🔧 WORKERS (Configuración)
# ========================================
# Número de réplicas de workers en el VPS
WORKER_REPLICAS=3

# Número de trabajos concurrentes por worker
WORKER_CONCURRENCY=2

# IMPORTANTE para Cloudflare, confía en los headers de proxy para IP real y protocolo
N8N_TRUST_PROXY=true
# ========================================
# 📝 NOTAS IMPORTANTES
# ========================================
# 1. Redis, PostgreSQL y Vault ya están corriendo
#    en OTRO Docker. Este archivo solo se CONECTA a ellos.
#
# 2. N8N_ENCRYPTION_KEY DEBE COINCIDIR entre:
#    - Este archivo (.env en VPS workers)
#    - El .env en PC local
#    (Los secretos se desencriptan igual en ambos lados)
#
# 3. Versión de n8n DEBE SER IGUAL:
#    - PC local: docker compose pull
#    - VPS workers: docker compose -f docker-compose.vps.yml pull
#
# 4. Para cambiar número de workers SIN reiniciar:
#    docker compose -f docker-compose.vps.yml up -d --scale n8n-worker=5
#
# 5. Este docker-compose.vps.yml SOLO levanta:
#    - n8n-workers (conectados a servicios externos)
#    NO LEVANTA Redis, PostgreSQL ni Vault
#
# 6. ACCESO A INTERNET:
#    Los contenedores usan network bridge que permite:
#    - Conectar a servicios externos (APIs, webhooks)
#    - Descargar integraciones/plugins
#    - Conectar a BD y Redis remotos
#    ✅ NO REQUIERE CONFIGURACIÓN ESPECIAL
