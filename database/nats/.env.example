# ============================================================================
# NATS JetStream compartido - ejemplo de variables de operación
# Copia este archivo a .env antes de levantar docker-compose.nats.yml
# ============================================================================

# Zona horaria del contenedor.
TZ=America/Bogota
GENERIC_TIMEZONE=America/Bogota

# Identidad del nodo NATS.
NATS_SERVER_NAME=nats-jetstream-primary
NATS_NODE_ID=node1
NATS_CONTAINER_NAME=nats-jetstream-node1

# Puerto de clientes NATS.
NATS_PORT=4223
# Puerto HTTP de monitoreo /healthz /varz /jsz.
NATS_HTTP_PORT=8223
# Puerto interno de cluster/routes.
NATS_CLUSTER_PORT=6223

# Credenciales obligatorias para clientes NATS.
NATS_USERNAME=nats_admin
NATS_PASSWORD=change_me_with_a_long_random_secret
# Credenciales obligatorias entre nodos del cluster.
NATS_CLUSTER_USERNAME=nats_route
NATS_CLUSTER_PASSWORD=change_me_with_a_second_long_random_secret

# IPs de bind publicas/locales.
NATS_BIND_PUBLIC_IP=100.121.34.76
NATS_BIND_LOCAL_IP=127.0.0.1
NATS_BIND_CLUSTER_IP=0.0.0.0

# Habilita TLS para tráfico cliente<->servidor.
NATS_TLS_ENABLED=false
# Certificado servidor NATS.
NATS_TLS_CERT_FILE=/etc/nats/ssl/server.crt
# Llave privada servidor NATS.
NATS_TLS_KEY_FILE=/etc/nats/ssl/server.key
# CA opcional para clientes que validan un root privado.
NATS_TLS_CA_FILE=/etc/nats/ssl/root.crt

# Límite máximo por payload publicado.
NATS_MAX_PAYLOAD=16MB
# Buffer máximo pendiente por conexión.
NATS_MAX_PENDING=256MB
# Deadline de escritura al socket.
NATS_WRITE_DEADLINE=10s
# Intervalo de ping entre servidor y cliente.
NATS_PING_INTERVAL=20s
# Pings fallidos permitidos antes de cerrar la conexión.
NATS_PING_MAX=3

# Escala de conexiones/subscripciones.
NATS_MAX_CONNECTIONS=20000
NATS_MAX_SUBSCRIPTIONS=100000

# JetStream persistence.
NATS_JETSTREAM_STORE_DIR=/data/nats
NATS_JETSTREAM_MAX_MEMORY_STORE=1GB
NATS_JETSTREAM_MAX_FILE_STORE=250GB
NATS_JETSTREAM_SYNC_INTERVAL=2m

# Cluster / HA
NATS_CLUSTER_ENABLED=false
NATS_CLUSTER_NAME=nats-jetstream-cluster
NATS_CLUSTER_LISTEN_HOST=0.0.0.0
NATS_CLUSTER_ADVERTISE_HOST=100.121.34.76
NATS_CLUSTER_ADVERTISE_PORT=6223
NATS_CLUSTER_ROUTES=

# Recursos del contenedor.
NATS_CONTAINER_CPUS=2.0
NATS_CONTAINER_MEMORY=4g
NATS_CONTAINER_PIDS_LIMIT=2048
NATS_ULIMIT_NOFILE_SOFT=65536
NATS_ULIMIT_NOFILE_HARD=65536
