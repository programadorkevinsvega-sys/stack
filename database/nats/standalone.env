# ============================================================================
# NATS JetStream compartido - variables reales de operación
# ============================================================================

TZ=America/Bogota
GENERIC_TIMEZONE=America/Bogota

NATS_SERVER_NAME=nats-jetstream-primary
NATS_PORT=4223
NATS_HTTP_PORT=8223
NATS_CLUSTER_PORT=6223
NATS_NODE_ID=node1
NATS_CONTAINER_NAME=nats-jetstream-node1

NATS_USERNAME=nats_admin
NATS_PASSWORD=Kevins1612522026
NATS_CLUSTER_USERNAME=nats_route
NATS_CLUSTER_PASSWORD=KevinsCluster1612522026

NATS_BIND_PUBLIC_IP=100.121.34.76
NATS_BIND_LOCAL_IP=127.0.0.1
NATS_BIND_CLUSTER_IP=0.0.0.0

NATS_TLS_ENABLED=false
NATS_TLS_CERT_FILE=/etc/nats/ssl/server.crt
NATS_TLS_KEY_FILE=/etc/nats/ssl/server.key
NATS_TLS_CA_FILE=/etc/nats/ssl/root.crt

NATS_MAX_PAYLOAD=16MB
NATS_MAX_PENDING=256MB
NATS_WRITE_DEADLINE=10s
NATS_PING_INTERVAL=20s
NATS_PING_MAX=3

NATS_MAX_CONNECTIONS=20000
NATS_MAX_SUBSCRIPTIONS=100000

NATS_JETSTREAM_STORE_DIR=/data/nats
NATS_JETSTREAM_MAX_MEMORY_STORE=2GB
NATS_JETSTREAM_MAX_FILE_STORE=250GB
NATS_JETSTREAM_SYNC_INTERVAL=2m

NATS_CLUSTER_ENABLED=false
NATS_CLUSTER_NAME=nats-jetstream-cluster
NATS_CLUSTER_LISTEN_HOST=0.0.0.0
NATS_CLUSTER_ADVERTISE_HOST=100.121.34.76
NATS_CLUSTER_ADVERTISE_PORT=6223
NATS_CLUSTER_ROUTES=

NATS_CONTAINER_CPUS=2.0
NATS_CONTAINER_MEMORY=4g
NATS_CONTAINER_PIDS_LIMIT=2048
NATS_ULIMIT_NOFILE_SOFT=65536
NATS_ULIMIT_NOFILE_HARD=65536
