  # ================================
  # 🧰 PgBouncer - Pool de conexiones
  # ================================
  pgbouncer:
    image: edoburu/pgbouncer:latest
    container_name: pgbouncer
    restart: unless-stopped
    depends_on:
      - postgres

    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-Kevins1612522026}

    command:
      - /bin/sh
      - -ec
      - |
        cat >/etc/pgbouncer/pgbouncer.ini <<EOF
        [databases]
        * = host=postgres port=5432

        [pgbouncer]
        listen_addr = 0.0.0.0
        listen_port = 6432
        auth_type = plain
        auth_file = /etc/pgbouncer/userlist.txt
        admin_users = ${POSTGRES_USER:-postgres}
        stats_users = ${POSTGRES_USER:-postgres}
        pool_mode = ${PGBOUNCER_POOL_MODE:-session}
        max_client_conn = ${PGBOUNCER_MAX_CLIENT_CONN:-800}
        default_pool_size = ${PGBOUNCER_DEFAULT_POOL_SIZE:-10}
        min_pool_size = ${PGBOUNCER_MIN_POOL_SIZE:-2}
        reserve_pool_size = ${PGBOUNCER_RESERVE_POOL_SIZE:-5}
        reserve_pool_timeout = ${PGBOUNCER_RESERVE_POOL_TIMEOUT:-5}
        max_db_connections = ${PGBOUNCER_MAX_DB_CONNECTIONS:-20}
        max_user_connections = ${PGBOUNCER_MAX_USER_CONNECTIONS:-20}
        server_reset_query = DISCARD ALL
        server_check_query = select 1
        server_check_delay = 30
        ignore_startup_parameters = extra_float_digits,search_path,options
        log_connections = 1
        log_disconnections = 1
        EOF
        printf '"%s" "%s"\n' "${POSTGRES_USER:-postgres}" "${POSTGRES_PASSWORD:-Kevins1612522026}" >/etc/pgbouncer/userlist.txt
        exec pgbouncer /etc/pgbouncer/pgbouncer.ini

    ports:
      - "100.121.34.76:6432:6432"
      - "127.0.0.1:6432:6432"

    healthcheck:
      test: [ "CMD-SHELL", "nc -z 127.0.0.1 6432" ]
      interval: 10s
      timeout: 5s
      retries: 5

    networks:
      - stack-network

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 128M

