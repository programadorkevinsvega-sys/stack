# Database Stack - SSL/TLS Configuration
# Copy this to .env file and customize as needed

# ================================
# SSL/TLS Configuration
# ================================
# Set to 'true' to enable SSL/TLS (requires valid certificates in ssl/generales/)
# Set to 'false' to disable SSL/TLS (plain connections)

# MongoDB - Default: false
MONGODB_ENABLE_SSL=false

# MySQL - Default: false
MYSQL_ENABLE_SSL=false

# PostgreSQL - Default: false
POSTGRES_ENABLE_SSL=false

# Redis - Default: false
REDIS_ENABLE_SSL=false

# RabbitMQ - Default: false
RABBITMQ_ENABLE_SSL=false

# Kafka - Default: false (optional, both PLAINTEXT and SSL always available)
KAFKA_ENABLE_SSL=false

# MinIO - Default: false
MINIO_ENABLE_SSL=false

# Vault - Default: false
VAULT_ENABLE_SSL=false

# ================================
# Database Credentials
# ================================

# MongoDB
MONGO_INITDB_ROOT_USERNAME=KevinsAdmin
MONGO_INITDB_ROOT_PASSWORD=Kevins1612522026

# MySQL
MYSQL_ROOT_PASSWORD=Kevins1612522026
MYSQL_DATABASE=n8n
MYSQL_USER=KevinsAdmin
MYSQL_PASSWORD=Kevins1612522026
MYSQL_ROOT_HOST=mysql
PMA_ROOT_PASSWORD=Kevins1612522026

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Kevins1612522026
POSTGRES_DB=postgres
POSTGRES_MAX_CONNECTIONS=1000
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB

# PgBouncer
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Kevins1612522026
PGBOUNCER_POOL_MODE=session
PGBOUNCER_MAX_CLIENT_CONN=4000
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=10
PGBOUNCER_RESERVE_POOL_SIZE=20
PGBOUNCER_MAX_DB_CONNECTIONS=200
PGBOUNCER_MAX_USER_CONNECTIONS=200

# PgAdmin
PGADMIN_DEFAULT_EMAIL=programadorkevinsvega@gmail.com
PGADMIN_DEFAULT_PASSWORD=Kevins1612522026

# Redis
REDIS_PASSWORD=Kevins1612522026

# RabbitMQ
